include README.md pyproject.toml .gitattributes .gitignore
exclude uv.lock
recursive-include src *.py
recursive-include docs *.md
recursive-include examples *.json
include rust/Cargo.toml rust/Cargo.lock rust/rust-toolchain.toml
recursive-include rust/src *.rs
prune tests
prune reports
prune rust/tests
prune rust/target
prune build
prune dist
prune .venv
exclude agents.md AGENTS.md AGENT.md plan.md MEMORY.md
exclude docs/P5A_PLAN.md docs/P5B_PLAN.md docs/P5_ROADMAP.md docs/PROJECT_RULES.md docs/index-builder-prep-v2-evidence.md
recursive-exclude tools *
global-exclude *.py[cod] *.log
