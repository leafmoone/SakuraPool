+def test_png_header_dimensions_are_indexed_without_decode(tmp_path):
+    source = tmp_path / "a.tar"
+    png = bytearray(b"\x89PNG\r\n\x1a\n")
+    png += b"\x00\x00\x00\x0dIHDR" + (12).to_bytes(4, "big") + (9).to_bytes(4, "big")
