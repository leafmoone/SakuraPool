        "-c",
        "import pathlib,subprocess,zipfile,hashlib,sakurapool,json\nroot=pathlib.Path(sakurapool.__file__).parent\nassert 'site-packages' in str(root),root\nz=zipfile.ZipFile('D:\\\\SakuraTool\\\\SakuraPool\\\\build\\\\final-r4-wheel\\\\sakurapool-0.1.0-py3-none-any.whl')\nrows=[]\nfor name in z.namelist():\n if not name.endswith('.py'): continue\n blob=subprocess.check_output(['git','show','92dc235048634f6e6404133645bbfa9a7172a5cc'+':src/'+name])\n data=z.read(name)\n assert blob.replace(b'\\r\\n',b'\\n')==data.replace(b'\\r\\n',b'\\n'),name\n assert data==(root.parent/name).read_bytes(),name\n rows.append({'path':name,'installed_sha256':hashlib.sha256(data).hexdigest(),'git_blob_sha256':hashlib.sha256(blob).hexdigest()})\nprint(json.dumps({'module':str(root),'wheel_sha256':hashlib.sha256(pathlib.Path(z.filename).read_bytes()).hexdigest(),'files':rows},indent=2))\n"
